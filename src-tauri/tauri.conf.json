{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind Palace",
  "version": "0.1.0",
  "identifier": "dev.mindpalace.local",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/mind-palace/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mind Palace — development",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["main-local"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "resources": {"resources/memory-worker/": "memory-worker/", "resources/memory-capture/": "memory-capture/"},
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
