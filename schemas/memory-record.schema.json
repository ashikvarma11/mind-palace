{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "kind": { "const": "decision" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "maxLength": 32768 },
    "scope_ids": { "type": "array", "maxItems": 0 },
    "evidence_refs": { "type": "array", "maxItems": 0 },
    "provenance": { "const": "user_entered" },
    "review_status": { "enum": ["unreviewed", "reviewed"] },
    "decision_state": { "enum": ["proposed", "confirmed"] },
    "confirmation_basis": { "enum": [null, "explicit_user_action"] },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "body",
    "scope_ids",
    "evidence_refs",
    "provenance",
    "review_status",
    "decision_state",
    "confirmation_basis",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "decision_state": { "const": "confirmed" } } },
      "then": {
        "properties": {
          "confirmation_basis": { "const": "explicit_user_action" },
          "review_status": { "const": "reviewed" }
        }
      },
      "else": { "properties": { "confirmation_basis": { "type": "null" } } }
    }
  ]
}
