{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mind-palace:native-memory:v1",
  "$defs": {
    "VaultStatus": {
      "title": "VaultStatus", "type": "object",
      "properties": {"connected": {"type": "boolean"}, "ai_enabled": {"const": false}},
      "required": ["connected", "ai_enabled"], "additionalProperties": false
    },
    "SessionMetadata": {
      "title": "SessionMetadata",
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "id": {"$ref": "#/$defs/Identifier"},
        "kind": {"const": "session"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_id": {"$ref": "#/$defs/Identifier"},
        "review_status": {"const": "unreviewed"},
        "source_kind": {"const": "hook_capture"},
        "provider": {"enum": ["claude-code", "codex"]},
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
        }
      },
      "required": ["schema_version", "id", "kind", "title", "source_id", "review_status", "created_at"],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "SessionRead": {
      "title": "SessionRead",
      "type": "object",
      "properties": {
        "metadata": {"$ref": "#/$defs/SessionMetadata"},
        "body": {"type": "string", "maxLength": 32768},
        "source_text": {"type": "string", "maxLength": 20971520}
      },
      "required": ["metadata", "body", "source_text"],
      "additionalProperties": false
    },
    "SessionList": {
      "title": "SessionList",
      "type": "object",
      "properties": {
        "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/SessionMetadata"}},
        "total": {"type": "integer", "minimum": 0, "maximum": 1000},
        "next_offset": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000}
      },
      "required": ["items", "total", "next_offset"],
      "additionalProperties": false
    },
    "SessionCreated": {
      "title": "SessionCreated",
      "type": "object",
      "properties": {"id": {"$ref": "#/$defs/Identifier"}},
      "required": ["id"],
      "additionalProperties": false
    },
    "MemoryAnswerSource": {
      "title": "MemoryAnswerSource",
      "type": "object",
      "properties": {
        "session_id": {"$ref": "#/$defs/Identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "quote": {"type": "string", "minLength": 1, "maxLength": 1200},
        "start": {"type": "integer", "minimum": 0, "maximum": 20971520},
        "end": {"type": "integer", "minimum": 1, "maximum": 20971520},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider": {"enum": ["claude-code", "codex"]}
      },
      "required": ["session_id", "title", "quote", "start", "end", "snapshot_sha256"],
      "additionalProperties": false
    },
    "MemoryAnswer": {
      "title": "MemoryAnswer",
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "status": {"enum": ["answered", "insufficient_evidence"]},
        "answer": {"type": "string", "minLength": 1, "maxLength": 8000},
        "sources": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/MemoryAnswerSource"}}
      },
      "required": ["schema_version", "status", "answer", "sources"],
      "additionalProperties": false
    }
  }
}
